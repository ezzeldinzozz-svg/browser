{
  "name": "browser",
  "productName": "Browser",
  "version": "0.5.0",
  "description": "A basic cross-platform browser built on Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "keygen": "node scripts/keygen.js",
    "release": "node scripts/release.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "author": "ezzeddinmagdy",
  "build": {
    "appId": "com.ezzeddinmagdy.browser",
    "productName": "Browser",
    "copyright": "Copyright © 2026 ezzeddinmagdy",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "adblock.js",
      "update-public-key.pem",
      "ui/**",
      "pages/**",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can see your location.",
        "NSBluetoothAlwaysUsageDescription": "Websites you allow can connect to Bluetooth devices."
      },
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Browser ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "publish": null,
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML document",
        "role": "Viewer"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2"
  }
}
