{
  "name": "browser",
  "productName": "Operecs",
  "version": "0.20.0",
  "description": "Operecs: a fast, private, cross-platform web browser",
  "main": "main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "keygen": "node scripts/keygen.js",
    "release": "node scripts/release.js",
    "build": "node scripts/build.js"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "author": "ezzeddinmagdy",
  "build": {
    "appId": "com.ezzeddinmagdy.browser",
    "productName": "Operecs",
    "copyright": "Copyright © 2026 ezzeddinmagdy",
    "files": [
      "main.js",
      "gen/preload.js",
      "gen/licenses.json",
      "capture-preload.js",
      "updater.js",
      "update-format.js",
      "adblock.js",
      "bookmarks.js",
      "update-public-key.pem",
      "ui/**",
      "pages/**",
      "history-db.js",
      "quick-answers.js",
      "qr.js",
      "i18n.js",
      "locales/**",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can see your location.",
        "NSBluetoothAlwaysUsageDescription": "Websites you allow can connect to Bluetooth devices."
      },
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Operecs ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "ezzeldinzozz-svg <282520688+ezzeldinzozz-svg@users.noreply.github.com>",
      "executableName": "browser",
      "synopsis": "A basic cross-platform web browser",
      "mimeTypes": [
        "text/html",
        "application/xhtml+xml",
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ]
    },
    "publish": null,
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML document",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "@mozilla/readability": "0.6.0",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  }
}
